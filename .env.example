# PayPal sandbox app — developer.paypal.com > Apps & Credentials > Sandbox
# The app must have the "Payouts" feature enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Google AI Studio key — aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=4173
# Optional: Claude writes the claims-adjuster notes (a different model family from
# the Gemini agents it judges). Without it, Gemini writes them and the UI says so.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
